<Window x:Class="GoodbyeDPI.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GoodbyeDPI.Gui.ViewModels"
        xmlns:controls="clr-namespace:GoodbyeDPI.Gui.Controls"
        Title="GoodbyeDPI Turkey" Width="1000" Height="680" ResizeMode="CanMinimize"
        Background="{StaticResource Bg0}" Icon="Assets/icon.ico"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- Sabit boyut: kenarlardan boyutlandırma yok, büyütme yok (ResizeMode=CanMinimize) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <controls:AuroraBackground />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══════════ Başlık çubuğu ═══════════ -->
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,8,0">
                    <Button Style="{StaticResource CaptionButton}" Tag="#14FFFFFF" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Tag="#E5534B" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="GoodbyeDPI" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="Turkey" FontSize="14" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <Border CornerRadius="6" Padding="7,2" Margin="10,0,0,0" Background="#14FFFFFF" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═══════════ Kenar çubuğu ═══════════ -->
                <Grid Grid.Column="0" Margin="14,8,6,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="NavHost">
                        <!-- Seçili sayfanın arkasında kayan gösterge -->
                        <Border x:Name="NavIndicator" Height="44" VerticalAlignment="Top" CornerRadius="12" Background="#12FFFFFF"
                                BorderBrush="#14FFFFFF" BorderThickness="1">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavIndicatorY" />
                            </Border.RenderTransform>
                            <Border Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Margin="-1,0,0,0" Background="{StaticResource AccentGradient}" />
                        </Border>
                        <StackPanel x:Name="NavPanel">
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Kontrol Paneli" IsChecked="True" Checked="Nav_Checked" Margin="0,0,0,4" />
                            <RadioButton x:Name="NavMethods" Style="{StaticResource NavButton}" Tag="&#xE945;" Content="Yöntemler" Checked="Nav_Checked" Margin="0,0,0,4" />
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Ayarlar" Checked="Nav_Checked" Margin="0,0,0,4" />
                            <RadioButton x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="&#xE8A5;" Content="Kayıtlar" Checked="Nav_Checked" />
                        </StackPanel>
                    </Grid>

                    <!-- VPN durumu -->
                    <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse x:Name="VpnDotPulse" Fill="{StaticResource Muted}" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="VpnPulseScale" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="VpnDotBrush" Color="{StaticResource IdleColor}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="VPN" FontWeight="SemiBold" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="VpnSideText" Style="{StaticResource MutedText}" Margin="20,4,0,0" Text="Bağlı değil" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════ Sayfalar ═══════════ -->
                <Grid x:Name="Pages" Grid.Column="1" Margin="10,8,20,16">

                    <!-- ─────── Kontrol paneli ─────── -->
                    <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Hidden" controls:SmoothScroll.IsEnabled="True">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform />
                        </ScrollViewer.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="Kontrol Paneli" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,14" Text="GoodbyeDPI'ı tek dokunuşla açıp kapatın. VPN bağlanınca kendiliğinden duraklar." />

                            <!-- Uyarılar -->
                            <StackPanel x:Name="Banners">
                                <Border x:Name="FolderBanner" Style="{StaticResource GlassCard}" BorderBrush="#66F87171" Margin="0,0,0,12" Padding="16,12" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Click="ChooseFolder_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="Klasör seç" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Bad}" Margin="0,0,12,0" />
                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="goodbyedpi.exe bulunamadı. Release ZIP'inden çıkardığınız klasörü (içinde x86_64\ olan) seçin." />
                                    </DockPanel>
                                </Border>
                                <Border x:Name="LegacyBanner" Style="{StaticResource GlassCard}" BorderBrush="#66FBBF24" Margin="0,0,0,12" Padding="16,12" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Eski script'i kaldır" Click="RemoveLegacyTask_Click" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" Margin="0,0,12,0" />
                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="Daha önce elle kurulan vpn-goodbyedpi-switch.ps1 script'i çalışıyor. Siz GoodbyeDPI'ı kapatsanız bile birkaç saniye içinde geri açar ve testleri bozar. Görevi uygulama üstlendiği için kaldırılmalı." />
                                    </DockPanel>
                                </Border>
                                <Border x:Name="ExternalBanner" Style="{StaticResource GlassCard}" BorderBrush="#66FBBF24" Margin="0,0,0,12" Padding="16,12" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Tamam" Click="DismissExternal_Click" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" Margin="0,0,12,0" />
                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="GoodbyeDPI servisi bu uygulamanın dışında yeniden başlatıldı. Servisi yöneten başka bir program, script ya da eski bir kurulum çalışıyor olabilir; o çalıştıkça kapatma kalıcı olmaz." />
                                    </DockPanel>
                                </Border>
                                <Border x:Name="ManualBanner" Style="{StaticResource GlassCard}" BorderBrush="#66FBBF24" Margin="0,0,0,12" Padding="16,12" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Durdur" Click="StopManual_Click" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" Margin="0,0,12,0" />
                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="Servis dışında, elle başlatılmış (turkey_dnsredir*.cmd) bir goodbyedpi.exe çalışıyor. Servisle aynı anda çalışmamalı." />
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Ana kart: güç düğmesi -->
                            <Border Style="{StaticResource GlassCard}" Padding="22,14,26,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="PowerHost" Width="210" Height="210">
                                        <!-- Radar gibi atan halkalar (servis açıkken) -->
                                        <Grid x:Name="PulseGroup" Opacity="0" IsHitTestVisible="False">
                                            <Ellipse Width="140" Height="140" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.Stroke>
                                                    <SolidColorBrush x:Name="PulseBrush1" Color="{StaticResource GoodColor}" />
                                                </Ellipse.Stroke>
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="Pulse1" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse Width="140" Height="140" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.Stroke>
                                                    <SolidColorBrush x:Name="PulseBrush2" Color="{StaticResource GoodColor}" />
                                                </Ellipse.Stroke>
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="Pulse2" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>

                                        <!-- Hale -->
                                        <Ellipse Width="204" Height="204" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop x:Name="HaloStop" Color="#405B6273" Offset="0.45" />
                                                    <GradientStop Color="#000B0C10" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- Dış iz halkası -->
                                        <Ellipse Width="170" Height="170" Stroke="#1AFFFFFF" StrokeThickness="2" IsHitTestVisible="False" />

                                        <!-- İşlem sürerken dönen yay -->
                                        <Grid x:Name="SpinGroup" Opacity="0" IsHitTestVisible="False">
                                            <Ellipse Width="170" Height="170" StrokeThickness="3" StrokeDashArray="16 44" StrokeDashCap="Round"
                                                     Stroke="{StaticResource AccentGradient}" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform x:Name="SpinRotate" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>

                                        <!-- Düğmenin kendisi -->
                                        <Grid x:Name="PowerVisual" Width="136" Height="136" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="PowerScale" />
                                            </Grid.RenderTransform>
                                            <Ellipse StrokeThickness="2">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#2A2E3B" Offset="0" />
                                                        <GradientStop Color="#13151C" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.Stroke>
                                                    <SolidColorBrush x:Name="CoreStrokeBrush" Color="{StaticResource IdleColor}" />
                                                </Ellipse.Stroke>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect x:Name="CoreGlow" Color="{StaticResource IdleColor}" BlurRadius="36" ShadowDepth="0" Opacity="0.5" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="48"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush x:Name="PowerIconBrush" Color="{StaticResource IdleColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Tıklanabilir alan (görsel katmanlar arkada) -->
                                        <Button x:Name="PowerButton" Width="136" Height="136" Cursor="Hand" Click="Toggle_Click"
                                                ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="600"
                                                MouseEnter="PowerButton_MouseEnter" MouseLeave="PowerButton_MouseLeave"
                                                PreviewMouseLeftButtonDown="PowerButton_Down" PreviewMouseLeftButtonUp="PowerButton_Up"
                                                FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Ellipse Fill="Transparent" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <!-- Radar halkaları -->
                                                        <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.45" Duration="0:0:2.4" RepeatBehavior="Forever">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.45" Duration="0:0:2.4" RepeatBehavior="Forever">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="PulseBrush1" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:2.4" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                                <BeginStoryboard>
                                                    <Storyboard BeginTime="0:0:1.2">
                                                        <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.45" Duration="0:0:2.4" RepeatBehavior="Forever">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.45" Duration="0:0:2.4" RepeatBehavior="Forever">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="PulseBrush2" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:2.4" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <!-- Dönen yay -->
                                                        <DoubleAnimation Storyboard.TargetName="SpinRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.3" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DURUM" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                        <TextBlock x:Name="StatusTitle" Text="…" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="StatusTitleY" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock x:Name="StatusDetail" Style="{StaticResource MutedText}" FontSize="13.5" Margin="0,6,0,0" />
                                        <TextBlock x:Name="StatTest" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" Opacity="0.8" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Canlı analiz -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,14,0,0" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="Canlı analiz" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                            <Border CornerRadius="6" Padding="7,2" Margin="10,0,0,0" Background="#1A34D399" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="LiveBlink" Width="6" Height="6" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,5,0">
                                                        <Ellipse.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="LiveBlink" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Ellipse.Triggers>
                                                    </Ellipse>
                                                    <TextBlock Text="CANLI" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Good}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,12,14">
                                                <TextBlock Text="GENEL IP" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                <TextBlock x:Name="LiveIp" Text="…" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,14">
                                                <TextBlock Text="KONUM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                <TextBlock x:Name="LiveLocation" Text="…" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,14">
                                                <TextBlock Text="SAĞLAYICI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                <TextBlock x:Name="LiveProvider" Text="…" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,14">
                                                <TextBlock x:Name="LiveReachLabel" Text="ENGELLİ SİTE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Ellipse x:Name="LiveReachDot" Width="7" Height="7" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock x:Name="LiveReach" Text="Kontrol ediliyor" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,14">
                                                <TextBlock Text="YÖNTEM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                <TextBlock x:Name="LiveMethod" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,14">
                                                <TextBlock Text="DNS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                <TextBlock x:Name="LiveDns" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,14">
                                                <TextBlock Text="ÇALIŞMA SÜRESİ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                <TextBlock x:Name="LiveUptime" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="İŞLEMCİ · BELLEK" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                <TextBlock x:Name="LiveCpu" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Stroke}" HorizontalAlignment="Center" />

                                    <!-- Anlık trafik grafiği -->
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Accent2}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LiveDown" Text="0 B/s" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Margin="4,0,10,0" />
                                                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#EC4899" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LiveUp" Text="0 B/s" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Margin="4,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Anlık trafik" Style="{StaticResource H2}" FontSize="13.5" />
                                        </DockPanel>
                                        <Border Height="92" CornerRadius="10" Background="#0AFFFFFF" Margin="0,12,0,8" ClipToBounds="True">
                                            <Grid x:Name="ChartHost" ClipToBounds="True">
                                                <Canvas x:Name="ChartGrid" />
                                                <Canvas x:Name="ChartCanvas">
                                                    <Canvas.RenderTransform>
                                                        <TranslateTransform x:Name="ChartShift" />
                                                    </Canvas.RenderTransform>
                                                    <Path x:Name="DownArea">
                                                        <Path.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#5522D3EE" Offset="0" />
                                                                <GradientStop Color="#0022D3EE" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Path.Fill>
                                                    </Path>
                                                    <Path x:Name="DownLine" Stroke="{StaticResource Accent2}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                                    <Path x:Name="UpArea">
                                                        <Path.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#44EC4899" Offset="0" />
                                                                <GradientStop Color="#00EC4899" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Path.Fill>
                                                    </Path>
                                                    <Path x:Name="UpLine" Stroke="#EC4899" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeDashArray="3 2" />
                                                </Canvas>
                                                <TextBlock x:Name="ChartMax" FontSize="9.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Muted}" Margin="8,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="LiveTotals" Style="{StaticResource MutedText}" FontSize="11.5" Text="Bu oturumda: —" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─────── Yöntemler ─────── -->
                    <ScrollViewer x:Name="PageMethods" VerticalScrollBarVisibility="Hidden" controls:SmoothScroll.IsEnabled="True" Visibility="Collapsed">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform />
                        </ScrollViewer.RenderTransform>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="CancelTestButton" Click="CancelTest_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="12,6" FontSize="12.5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                                            <TextBlock Text="İptal" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TestAllButton" Style="{StaticResource AccentButton}" Click="TestAll_Click" Padding="13,6" FontSize="12.5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                                            <TextBlock Text="Tümünü test et" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Yöntemler" Style="{StaticResource H1}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16"
                                       Text="Her yöntem kurulmadan birkaç saniyeliğine çalıştırılır ve engelli sitelere gerçek bağlantı denenir. Böylece hangisinin bu cihazda ve bu ağda çalıştığını kurmadan görürsünüz." />

                            <!-- Test ilerlemesi -->
                            <Border x:Name="TestProgressCard" Style="{StaticResource GlassCard}" Padding="18,14" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="TestProgressCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" />
                                        <TextBlock x:Name="TestProgressText" FontWeight="SemiBold" Text="Hazırlanıyor…" />
                                    </DockPanel>
                                    <Grid x:Name="ProgressTrack" Height="6" Margin="0,10,0,0">
                                        <Border CornerRadius="3" Background="#14FFFFFF" />
                                        <!-- Dolu kısım: parlama bunun içinde kalsın diye ölçek yerine genişlik canlandırılır -->
                                        <Grid x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" ClipToBounds="True">
                                        <Border CornerRadius="3" Background="{StaticResource AccentGradient}" />
                                        <Rectangle Width="120" HorizontalAlignment="Left">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#80FFFFFF" Offset="0.5" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="ProgressShine" />
                                            </Rectangle.RenderTransform>
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ProgressShine" Storyboard.TargetProperty="X" From="-140" To="900" Duration="0:0:1.6" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="BaselineCard" CornerRadius="12" Padding="14,10" Margin="0,0,0,14" Background="#0DFFFFFF" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock x:Name="BaselineIcon" Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2}" Margin="0,0,12,0" VerticalAlignment="Top" />
                                    <TextBlock x:Name="BaselineText" Style="{StaticResource MutedText}" Foreground="{StaticResource Text}" />
                                </DockPanel>
                            </Border>

                            <ItemsControl x:Name="PresetList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PresetRow}">
                                        <Border x:Name="Card" Margin="0,0,0,12" CornerRadius="16" Background="#B3151820" BorderThickness="1">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#1FFFFFFF" />
                                            </Border.BorderBrush>
                                            <Border.RenderTransform>
                                                <TranslateTransform />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Kartın içinde, kenarlardan içeride duran durum şeridi -->
                                                <Border x:Name="Strip" Width="4" CornerRadius="2" Margin="12,16,0,16" Background="#26FFFFFF" />

                                                <StackPanel Grid.Column="1" Margin="14,16,12,16">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource Chip}" Background="#2634D399" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="Aktif" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Good}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Background="{StaticResource AccentGradient}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock Text="Önerilen" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Arguments}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                               Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding DnsNote}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                                    </StackPanel>

                                                    <!-- Site bazında sonuçlar -->
                                                    <ItemsControl ItemsSource="{Binding Sites}" Margin="0,10,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:SiteView}">
                                                                <Border x:Name="SiteChip" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" Background="#1A34D399">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock x:Name="SiteGlyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource Good}" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding Host}" FontSize="11.5" />
                                                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                                        <Setter TargetName="SiteChip" Property="Background" Value="#1AF87171" />
                                                                        <Setter TargetName="SiteGlyph" Property="Foreground" Value="{StaticResource Bad}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding StartError}" Foreground="{StaticResource Bad}" FontSize="11.5" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,16,18,16">
                                                    <!-- Uyumluluk rozeti -->
                                                    <Border x:Name="Badge" CornerRadius="7" Padding="10,5" Background="#14FFFFFF" RenderTransformOrigin="0.5,0.5" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="{Binding DetailText}">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform />
                                                        </Border.RenderTransform>
                                                        <TextBlock x:Name="BadgeText" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                    </Border>
                                                    <Button Click="TestOne_Click" Tag="{Binding}" Margin="0,0,8,0"
                                                            IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                                                            <TextBlock Text="Test" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource AccentButton}" Click="Install_Click" Tag="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" />
                                                            <TextBlock Text="Kur" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Test sırasında kartın üzerinden geçen parlama -->
                                                <Rectangle x:Name="Shimmer" Grid.ColumnSpan="3" Width="220" HorizontalAlignment="Left" IsHitTestVisible="False" Visibility="Collapsed">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#008B5CF6" Offset="0" />
                                                            <GradientStop Color="#338B5CF6" Offset="0.5" />
                                                            <GradientStop Color="#0022D3EE" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                    <Rectangle.RenderTransform>
                                                        <TranslateTransform x:Name="ShimmerX" />
                                                    </Rectangle.RenderTransform>
                                                    <Rectangle.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ShimmerX" Storyboard.TargetProperty="X" From="-240" To="900" Duration="0:0:1.5" RepeatBehavior="Forever">
                                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Rectangle.Triggers>
                                                </Rectangle>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Resources>
                                            <!-- Sonuç geldiğinde rozet esneyerek belirir -->
                                            <Storyboard x:Key="BadgePop">
                                                <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.5" To="1" Duration="0:0:0.6">
                                                    <DoubleAnimation.EasingFunction><ElasticEase Oscillations="2" Springiness="4" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.5" To="1" Duration="0:0:0.6">
                                                    <DoubleAnimation.EasingFunction><ElasticEase Oscillations="2" Springiness="4" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </DataTemplate.Resources>

                                        <DataTemplate.Triggers>
                                            <!-- Üzerine gelince kart hafifçe yükselir -->
                                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#4D8B5CF6" Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#1FFFFFFF" Duration="0:0:0.3" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>

                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Card" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#34D399" BlurRadius="26" ShadowDepth="0" Opacity="0.28" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                <Setter TargetName="Shimmer" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Strip" Property="Background" Value="{StaticResource AccentGradient}" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Accent2}" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:CompatKind.Full}">
                                                <Setter TargetName="Strip" Property="Background" Value="{StaticResource Good}" />
                                                <Setter TargetName="Badge" Property="Background" Value="#2634D399" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Good}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource BadgePop}" />
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:CompatKind.Partial}">
                                                <Setter TargetName="Strip" Property="Background" Value="{StaticResource Warn}" />
                                                <Setter TargetName="Badge" Property="Background" Value="#26FBBF24" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Warn}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource BadgePop}" />
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:CompatKind.None}">
                                                <Setter TargetName="Strip" Property="Background" Value="{StaticResource Bad}" />
                                                <Setter TargetName="Badge" Property="Background" Value="#26F87171" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Bad}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource BadgePop}" />
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─────── Ayarlar ─────── -->
                    <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Hidden" controls:SmoothScroll.IsEnabled="True" Visibility="Collapsed">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform />
                        </ScrollViewer.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="Ayarlar" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18" Text="Değişiklikler hemen uygulanır ve kaydedilir." />

                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="AutoPauseCheck" Style="{StaticResource ToggleSwitch}" Click="SettingCheck_Click">
                                        <StackPanel>
                                            <TextBlock Text="VPN algılanınca otomatik durdur" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                                       Text="GoodbyeDPI, VPN tünelinin içindeki trafiği de değiştirip bağlantıyı bozar. VPN bağlanınca durdurulur, VPN kapanınca yeniden açılır." />
                                        </StackPanel>
                                    </CheckBox>
                                    <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="0,16" />
                                    <CheckBox x:Name="AutostartCheck" Style="{StaticResource ToggleSwitch}" Click="SettingCheck_Click">
                                        <StackPanel>
                                            <TextBlock Text="Windows açılınca başlat" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" Text="Oturum açılınca tepside, yönetici izni sormadan başlar." />
                                        </StackPanel>
                                    </CheckBox>
                                    <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="0,16" />
                                    <CheckBox x:Name="TrayCheck" Style="{StaticResource ToggleSwitch}" Click="SettingCheck_Click">
                                        <StackPanel>
                                            <TextBlock Text="Kapatınca tepsiye küçült" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" Text="VPN takibinin sürmesi için uygulama arka planda çalışmaya devam eder." />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="GoodbyeDPI klasörü" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,10" Text="Release ZIP'inden çıkarılan, içinde x86_64\goodbyedpi.exe ve .cmd dosyaları olan klasör." />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Click="ChooseFolder_Click" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="Değiştir" />
                                            </StackPanel>
                                        </Button>
                                        <TextBox x:Name="FolderBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalContentAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Test siteleri" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,10"
                                               Text="Her satıra bir adres. Bu ağda erişimi engelli siteler olmalı; engelsiz bir site her yöntemde açılacağı için test bir şey söylemez. İlk adres, Kontrol Paneli'nde canlı erişim kontrolü için de kullanılır." />
                                    <TextBox x:Name="UrlsBox" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Hidden" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" />
                                    <Button Click="SaveUrls_Click" HorizontalAlignment="Left" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Siteleri kaydet" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" BorderBrush="#33F87171">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Click="RemoveService_Click" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Servisi kaldır" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Servisi kaldır" Style="{StaticResource H2}" Foreground="{StaticResource Bad}" />
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" Text="GoodbyeDPI servisini ve WinDivert sürücülerini kaldırır (service_remove.cmd ile aynı)." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─────── Kayıtlar ─────── -->
                    <Grid x:Name="PageLogs" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,18">
                            <Button DockPanel.Dock="Right" Click="OpenLog_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Log dosyasını aç" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="Kayıtlar" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Servis işlemleri, VPN olayları ve test sonuçları." />
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="6">
                            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                     VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" BorderThickness="0" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════ Bildirim (toast) ═══════════ -->
        <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="420"
                CornerRadius="12" Padding="16,12" Background="#F21B1E28" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastY" Y="30" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" />
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Border.Background>
                        <SolidColorBrush x:Name="ToastIconBg" Color="#338B5CF6" />
                    </Border.Background>
                    <TextBlock x:Name="ToastIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center" Foreground="White" />
                </Border>
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
